rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Normalised parts used to build the document id (case-insensitive, trimmed).
    function norm(s) {
      return s.trim().lower().replace('/', '%2F');
    }

    // Deterministic id: one book per (user, title, author), letter case ignored.
    // The title length prefix keeps (title, author) pairs unambiguous.
    function bookKey(d) {
      return d.userId + '|' + string(norm(d.title).size()) + '|' + norm(d.title) + '|' + norm(d.author);
    }

    function validBook(d, id) {
      return d.keys().hasOnly(['id', 'userId', 'title', 'author', 'genre', 'status',
                               'rating', 'favorite', 'notes', 'createdAt'])
        && d.keys().hasAll(['id', 'userId', 'title', 'author', 'genre', 'status',
                            'favorite', 'notes', 'createdAt'])
        && d.id == id
        && d.userId is string && d.userId == request.auth.uid
        && d.title is string && d.title.trim().size() > 0 && d.title.size() <= 100
        && d.author is string && d.author.trim().size() > 0 && d.author.size() <= 60
        && d.genre in ['Fiction', 'Non-Fiction', 'Academic', 'Other']
        && d.status in ['To Read', 'Reading', 'Finished']
        && (!('rating' in d) || d.rating == null || (d.rating is int && d.rating >= 0 && d.rating <= 5))
        && d.favorite is bool
        && d.notes is string && d.notes.size() <= 300
        && d.createdAt is timestamp
        && id == bookKey(d);
    }

    match /books/{bookId} {
      // A get of a document that does not exist yet (the duplicate check when a book is
      // renamed) is only allowed for ids that start with the caller's own uid.
      allow get: if request.auth != null
        && (resource == null
            ? bookId.split('\\|')[0] == request.auth.uid
            : resource.data.userId == request.auth.uid);

      allow list: if request.auth != null && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null && validBook(request.resource.data, bookId);

      // userId, createdAt and the (title, author) key never change on an update:
      // a rename is done by deleting and creating under the new key.
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && validBook(request.resource.data, bookId)
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
